#!/usr/bin/env sh
set -eu

# No attribution trailers on any commit (docs/rules/release.md): Co-Authored-By,
# Claude-Session, or "Generated with [Claude Code]". Comment lines git adds to
# the editor template are ignored.
msg_file="$1"

offending="$(grep -v '^#' "$msg_file" | grep -inE '^[[:space:]]*(co-authored-by|claude-session)[[:space:]]*:|^[^[:alnum:]]*generated with \[?claude' || true)"

if [ -n "$offending" ]; then
  echo "commit-msg: remove the attribution trailer(s) below and commit again:" >&2
  printf '%s\n' "$offending" >&2
  exit 1
fi
